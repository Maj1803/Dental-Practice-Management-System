<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MTKhan_Dentist.SiteMaster" %>
<%@ Import Namespace="System" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" runat="server" href="~/">
                    <img src="~/Images/new-logo.png" alt="Dr Mt Khan Dental Logo" style="height: 45px; margin-right: 10px; margin-top: -6px;" runat="server" />
                    DR MT KHAN DENTAL
                </a>
                
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/">Home</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/About">About</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact">Contact</a></li>
                        
                <!-- MY ACCOUNT DROPDOWN -->
                <% if (Session["Role"] != null) { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="privateAreaDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">My Account</a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="privateAreaDropdown">

                        <%-- CHECK IF USER IS PATIENT --%>
                        <% if (Session["Role"].ToString().Equals("Patient", StringComparison.OrdinalIgnoreCase)) { %>
                            <li><h6 class="dropdown-header">Patient</h6></li>
                            <li><a class="dropdown-item" href="/PrivatePages/PatientDashboard.aspx">Patient Dashboard</a></li>
                            <li><a class="dropdown-item" href="/PrivatePages/MyAppointments.aspx">My Appointments</a></li>
                            <li><a class="dropdown-item" href="/PrivatePages/PatientMessages.aspx">Messages</a></li>
                            <li><a class="dropdown-item" href="/Account/Manage.aspx">Manage Profile</a></li>
                        <% } %>

                        <%-- CHECK IF USER IS RECEPTIONIST --%>
                        <% if (Session["Role"].ToString().Equals("Receptionist", StringComparison.OrdinalIgnoreCase)) { %>
                            <li><h6 class="dropdown-header">Staff</h6></li>
                            <li><a class="dropdown-item" href="/PrivatePages/StaffDashboard.aspx">Staff Dashboard</a></li>
                            <li><a class="dropdown-item" href="/PrivatePages/StaffMessages.aspx">Message Board</a></li>
                            <li><a class="dropdown-item" href="/PrivatePages/IncomingRequests.aspx">Incoming Requests</a></li>
                        <% } %>

                        <%-- CHECK IF USER IS DENTIST --%>
                        <% if (Session["Role"].ToString().Equals("Dentist", StringComparison.OrdinalIgnoreCase)) { %>
                            <li><h6 class="dropdown-header">Staff</h6></li>
                            <li><a class="dropdown-item" href="/PrivatePages/StaffDashboard.aspx">Staff Dashboard</a></li>
                            <li><a class="dropdown-item" href="/PrivatePages/StaffMessages.aspx">Message Board</a></li>
                            <li><a class="dropdown-item" href="/PrivatePages/ManageSchedule.aspx">Manage Schedule</a></li>
                        <% } %>
                    </ul>
                </li>
                <% } %>                                        

                        <!-- REQUEST APPOINTMENT (Only visible to Patients and Anonymous users) -->
                        <% if (Session["Role"] == null || Session["Role"].ToString().Equals("Patient", StringComparison.OrdinalIgnoreCase)) { %>
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/RequestApp.aspx">Request Appointment</a>
                        </li>
                        <% } %>

                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/Help">Help</a>
                        </li>
                    </ul>
                    
                    <asp:LoginView runat="server" ViewStateMode="Disabled">
                        <AnonymousTemplate>
                            <ul class="navbar-nav navbar-right">
                                <li><a runat="server" class="nav-link" href="~/Account/Register">Register</a></li>
                                <li><a runat="server" class="nav-link" href="~/Account/Login">Log in</a></li>
                            </ul>
                        </AnonymousTemplate>
                        <LoggedInTemplate>
                            <ul class="navbar-nav navbar-right">
                                <li><a runat="server" class="nav-link" href="~/PrivatePages/PatientDashboard.aspx" title="Profile">Hello, <%: Context.User.Identity.GetUserName()  %> !</a></li>
                                <li>
                                    <asp:LoginStatus runat="server" CssClass="nav-link" LogoutAction="Redirect" LogoutText="Log off" LogoutPageUrl="~/" OnLoggingOut="Unnamed_LoggingOut" />
                                </li>
                            </ul>
                        </LoggedInTemplate>
                    </asp:LoginView>
                </div>
            </div>
        </nav>
        
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> - Dr MT KHAN DENTAL 2026</p>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.bundle.js") %>
    </asp:PlaceHolder>
</body>
</html>